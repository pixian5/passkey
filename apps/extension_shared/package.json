{
  "name": "pass-extension-shared",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "description": "Shared build pipeline for Pass browser extensions.",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:watch": "node ./scripts/build.mjs --watch",
    "test": "node --test ./tests/*.test.mjs",
    "test:core-parity": "node ../../core/pass_core/js/check_merge_parity.mjs",
    "test:all": "npm test && npm run test:core-parity"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5"
  }
}
