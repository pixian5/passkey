{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pass.local/schemas/sync-operation-report-v1.schema.json",
  "title": "pass.sync.operation-report.v1",
  "description": "三端同步操作的统一结果。code、etag、revision 只在相应阶段可用时出现。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportVersion",
    "ok",
    "dryRun",
    "mode",
    "message",
    "safe",
    "safety",
    "reasons",
    "localAccounts",
    "remoteAccounts",
    "mergedAccounts",
    "applied",
    "pushed",
    "remotePulled",
    "pendingRetry",
    "retryable",
    "stage",
    "source",
    "syncSessionId",
    "operationId"
  ],
  "properties": {
    "reportVersion": { "const": 1 },
    "ok": { "type": "boolean" },
    "dryRun": { "type": "boolean" },
    "mode": { "enum": ["merge", "remoteOverwriteLocal", "localOverwriteRemote"] },
    "message": { "type": "string" },
    "safe": { "type": "boolean" },
    "safety": { "enum": ["passed", "blocked", "notEvaluated"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "localAccounts": { "type": "integer", "minimum": 0 },
    "remoteAccounts": { "type": "integer", "minimum": 0 },
    "mergedAccounts": { "type": "integer", "minimum": 0 },
    "applied": { "type": "boolean" },
    "pushed": { "type": "boolean" },
    "remotePulled": { "type": "boolean" },
    "pendingRetry": { "type": "boolean" },
    "retryable": { "type": "boolean" },
    "stage": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "syncSessionId": { "type": "string" },
    "operationId": { "type": "string" },
    "code": { "type": "string" },
    "etag": { "type": "string" },
    "uploadedTargets": {
      "type": "integer",
      "minimum": 0,
      "description": "真正发起过上传且成功的目标数；与 identicalTargets 互斥计数"
    },
    "identicalTargets": {
      "type": "integer",
      "minimum": 0,
      "description": "远端内容与待提交内容一致、跳过上传但仍已确认的目标数"
    },
    "revision": { "type": "integer", "minimum": 0 }
  }
}
